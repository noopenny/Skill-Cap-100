<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPT 4.1.6 客户端插件 - SkillCap100.Client (BepInEx 5 / HarmonyX)
    ==================================================================
    Tarkov 的技能效果（后坐力减免、搜索速度、耐力、负重……）**完全在客户端**由
    Assembly-CSharp.dll 中的 EFT.SkillManager / EFT.Skill / EFT.BaseSkill 本地计算，
    服务端只保存技能经验值。因此 52~100 级要产生实际效果，必须有这个客户端插件。

    目标框架 netstandard2.1 —— 与本机其它 SPT 客户端模组（SAIN / WTT / spt-*.dll）一致。

    如果本工程被移动到游戏目录之外，请通过命令行覆盖 GameRoot：
      dotnet build -c Release /p:GameRoot="D:\game\Client.0.16.9.5.40743"
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SkillCap100.Client</AssemblyName>
    <RootNamespace>SkillCap100.Client</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <Product>Skill Cap 100 (Client)</Product>
    <Description>Client-side BepInEx plugin that lets skill effects keep scaling from level 52 to 100 and moves elite effects to level 100.</Description>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
<GameRoot>D:\game\Client.0.16.9.5.40743</GameRoot>
    <ManagedDir>$(GameRoot)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameRoot)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
